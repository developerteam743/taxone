generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String         @id @default(uuid())
  name         String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  memberships  Membership[]
  auditLogs    AuditLog[]
  authSessions AuthSession[]
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  passwordHash   String
  mfaCredential  MfaCredential?
  mfaChallenges  MfaChallenge[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  memberships    Membership[]
  auditLogs      AuditLog[]
  authSessions   AuthSession[]
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  CA
  MEMBER
  CLIENT
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  requestId      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model AuthSession {
  id               String        @id @default(uuid())
  userId           String
  organizationId   String?
  accessTokenHash  String        @unique
  refreshTokenHash String        @unique
  refreshFamilyId  String
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  lastUsedAt       DateTime?
  rotatedAt        DateTime?
  revokedAt        DateTime?
  userAgent        String?
  ipHash           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([organizationId, revokedAt])
  @@index([refreshFamilyId])
  @@index([refreshExpiresAt])
}

model MfaCredential {
  id              String            @id @default(uuid())
  userId          String            @unique
  encryptedSecret String
  recoveryCodes   MfaRecoveryCode[]
  enabledAt       DateTime?
  disabledAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([disabledAt])
}

model MfaRecoveryCode {
  id           String        @id @default(uuid())
  credentialId String
  codeHash     String
  consumedAt   DateTime?
  createdAt    DateTime      @default(now())
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, consumedAt])
}

model MfaChallenge {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([expiresAt])
}
