# Production configuration template. Never commit real secrets.
NODE_ENV=production

POSTGRES_DB=taxone
POSTGRES_USER=taxone
POSTGRES_PASSWORD=replace-with-long-random-password
DATABASE_URL=postgresql://taxone:replace-with-long-random-password@postgres:5432/taxone
REDIS_URL=redis://redis:6379

JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-bytes

# Public HTTPS origin, e.g. https://taxone.example.com
TAXONE_DOMAIN=taxone.example.com
APP_URL=https://taxone.example.com
NEXT_PUBLIC_API_URL=https://taxone.example.com/api/v1

# Private document storage is strongly recommended in production.
STORAGE_PROVIDER=s3
STORAGE_PATH=/data/storage
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=taxone-private
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Use a real provider only after security/compliance review.
OCR_PROVIDER=mock
OCR_API_KEY=
